<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Meine Praktikumsbewerbung – Klasse 8</title><style>
:root{font-family:system-ui,-apple-system,sans-serif;color:#193139;background:#f2f7f6}*{box-sizing:border-box}body{margin:0}header{background:#12675f;color:white;padding:24px 18px}header>div,main{max-width:840px;margin:auto}h1{font-size:clamp(25px,5vw,36px);margin:6px 0}h2{font-size:24px}h3{font-size:19px}main{padding:18px 12px 50px}.card{background:white;border:1px solid #d5e2e0;border-radius:17px;padding:clamp(16px,4vw,30px);box-shadow:0 2px 12px #153e3410}.sub{color:#4c666a;font-size:14px;line-height:1.5}p{line-height:1.55}.nav{display:flex;justify-content:space-between;gap:10px;margin-top:24px}button{background:#12675f;color:white;border:0;border-radius:10px;padding:12px 16px;min-height:44px;font:600 15px system-ui;cursor:pointer}button.alt{background:#e6f1ef;color:#125c54}button:disabled{opacity:.45}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid #e5a328;outline-offset:2px}.steps{display:flex;flex-wrap:wrap;gap:6px;margin:15px 0 22px}.steps button{background:#e6f1ef;color:#175e55;padding:8px 11px;min-height:40px}.steps button.active{background:#12675f;color:white}.choice{display:block;border:1px solid #cbdcd8;border-radius:12px;padding:13px;margin:9px 0;cursor:pointer}.choice:has(input:checked){background:#e4f5ee;border-color:#168b77}.choice input{margin-right:9px;accent-color:#12675f}.field{margin:18px 0}.field>label,.label{display:block;font-weight:700;margin-bottom:8px}input[type=text],textarea,select{display:block;width:100%;font:inherit;border:1px solid #a6c1bc;border-radius:10px;padding:12px;margin-top:7px}textarea{min-height:90px;resize:vertical;text-transform:none} .continuation{autocapitalize:off;text-transform:none} .pair{display:grid;grid-template-columns:1fr 1fr;gap:12px}@media(max-width:540px){.pair{grid-template-columns:1fr}}.start{font-weight:750;background:#e9f4f1;padding:12px;border-radius:9px;margin:10px 0 4px}.help{background:#f0f6f4;padding:13px;border-radius:10px;margin-top:10px}.help p{margin:6px 0}.preview{background:#fafcfb;border:1px solid #cedfdb;border-radius:10px;padding:16px;white-space:pre-wrap;line-height:1.65;font-family:Georgia,serif}.note{background:#fff3dc;border-radius:10px;padding:12px;margin:15px 0}.pill{display:inline-block;background:#e8f2f0;padding:5px 10px;border-radius:30px;font-size:13px}.hidden{display:none}.progress{height:8px;background:#d9e7e4;border-radius:10px;overflow:hidden}.progress>div{height:100%;background:#158b79;transition:width .2s}footer{text-align:center;color:#5a7071;font-size:13px;margin:20px}.row{display:flex;gap:10px;flex-wrap:wrap}.row button{flex:1}details{background:#eff6f4;border-radius:10px;padding:12px;margin:10px 0}summary{cursor:pointer;font-weight:650}ul{line-height:1.7}.smallprint{font-size:13px;color:#4e696a}#finalText{min-height:420px;font-family:Georgia,serif;line-height:1.6}
</style></head><body><header><div><div>BEWERBUNGSWERKSTATT · KLASSE 8</div><h1>✍️ Meine Praktikumsbewerbung</h1><div>Deine Gedanken. Deine Beispiele. Deine Bewerbung.</div></div></header><main><div class="card"><div id="count" class="sub"></div><div class="progress"><div id="bar"></div></div><div class="steps" id="steps"></div><section id="stage"></section><div class="nav"><button id="back" class="alt">← Zurück</button><button id="next">Weiter →</button></div></div><footer>Keine Anmeldung · Keine KI · Deine Eingaben bleiben auf diesem Gerät · Für Pages auf dem iPad</footer></main><script>
'use strict';
const chapters=[
{title:'Warum dieser Beruf?',options:['Ich möchte diesen Beruf kennenlernen, weil ich','Ich interessiere mich für diesen Beruf, weil ich','Ich möchte in diesem Beruf ein Praktikum machen, weil ich'],ideas:['gerne mit Kindern arbeite','gerne anderen Menschen helfe','mehr über die Arbeit mit Tieren erfahren möchte','gerne mit meinen Händen arbeite','gerne koche und backe','mich für Autos und Motoren interessiere','gerne Dinge repariere','mich für Computer und Technik interessiere','gerne kreativ gestalte','gerne draußen arbeite','gerne mit anderen Menschen spreche','gerne etwas Neues lerne','mich für Medizin und Gesundheit interessiere','gerne etwas organisiere','gerne Sport mache','gerne mit Pflanzen arbeite','gerne zeichne und gestalte','wissen möchte, wie Waren verkauft werden'],prompt:'Nenne ZWEI unterschiedliche Gründe. Schreibe in beide Lücken nur die Fortsetzung nach „weil ich“. Die beiden Teile werden mit „und“ verbunden.'},
{title:'Warum dieser Betrieb?',options:['Ich möchte mein Praktikum gerne bei Ihnen machen, weil','Ihr Betrieb interessiert mich besonders, weil','Ich habe mich für Ihren Betrieb entschieden, weil'],ideas:['ich Ihren Betrieb von einem Besuch kenne','ich Ihre Internetseite interessant finde','ich dort verschiedene Aufgaben kennenlernen kann','ich gerne sehen möchte, wie Sie arbeiten','mir Ihr Angebot für Kinder gefällt','mich Ihre Arbeit mit Tieren interessiert','ich schon viel Gutes über Ihren Betrieb gehört habe','ich Ihren Betrieb aus meiner Nachbarschaft kenne','mich Ihre Werkstatt und die Maschinen interessieren','ich Ihre Produkte interessant finde','ich bei Ihnen etwas über den Umgang mit Kunden lernen möchte','mich die verschiedenen Berufe in Ihrem Betrieb interessieren','ich Ihre Arbeit im Garten oder draußen kennenlernen möchte','ich gerne erfahren möchte, wie Ihr Team zusammenarbeitet','mir ein bestimmtes Projekt auf Ihrer Internetseite aufgefallen ist'],prompt:'Was ist an genau diesem Betrieb interessant? Nutze nur Gründe, die wirklich stimmen.'},
{title:'Meine erste Stärke',options:['Eine besondere Stärke von mir ist','Zu meinen Stärken gehört','Ich bin besonders gut darin,'],ideas:['meine Geduld','meine Zuverlässigkeit','meine Hilfsbereitschaft','meine Kreativität','meine Sorgfalt','meine Freundlichkeit','meine Teamfähigkeit','meine Ausdauer','Zuverlässigkeit','Geduld','Hilfsbereitschaft','Kreativität','Sorgfalt','Freundlichkeit','Teamfähigkeit','Ausdauer','anderen Menschen zu helfen','geduldig zuzuhören','mit anderen zusammenzuarbeiten','Aufgaben sorgfältig zu erledigen'],prompt:'Wähle eine Stärke. Achte auf die Form: „meine Geduld“ / „Geduld“ / „anderen zu helfen“.'},
{title:'Ein Beispiel für meine erste Stärke',options:['Das zeigt sich zum Beispiel daran, dass','Das habe ich schon gezeigt, als','Ein Beispiel dafür ist, dass'],ideas:['ich regelmäßig auf meine Geschwister aufpasse','ich zu Hause zuverlässig den Müll rausbringe','ich mein Haustier jeden Tag versorge','ich einem Freund bei den Hausaufgaben helfe','ich in einer Gruppenarbeit Aufgaben übernehme','ich anderen geduldig etwas erkläre','ich beim Sport auf meine Mitspieler achte','ich beim Backen genau nach Rezept arbeite','ich bei einer schwierigen Aufgabe nicht aufgebe','ich jemandem beim Umzug geholfen habe','ich ein jüngeres Kind getröstet habe','ich bei einem Schulfest mitgeholfen habe','ich bei einem Streit ruhig geblieben bin','ich meine Aufgaben pünktlich erledige','ich für andere etwas organisiert habe','ich einem Nachbarn beim Einkaufen geholfen habe'],prompt:'Wann hast du diese Stärke WIRKLICH gezeigt? Denke an Familie, Schule, Freunde, Sport oder Freizeit.'},
{title:'Meine zweite Stärke',options:['Eine weitere Stärke von mir ist','Außerdem gehört zu meinen Stärken','Ich bin auch gut darin,'],ideas:['meine Hilfsbereitschaft','meine Geduld','meine Zuverlässigkeit','meine Kreativität','meine Teamfähigkeit','meine Sorgfalt','meine Freundlichkeit','meine Ausdauer','Hilfsbereitschaft','Geduld','Zuverlässigkeit','Kreativität','Teamfähigkeit','Sorgfalt','Freundlichkeit','Ausdauer','mit anderen zusammenzuarbeiten','anderen zuzuhören','kreative Lösungen zu finden','Aufgaben zuverlässig zu erledigen'],prompt:'Wähle eine ZWEITE Stärke. Sie sollte anders sein als die erste.'},
{title:'Ein Beispiel für meine zweite Stärke',options:['Das zeigt sich daran, dass','Das habe ich zum Beispiel gezeigt, als','Ein Beispiel dafür ist, dass'],ideas:['ich einem Freund beim Lernen geholfen habe','ich bei einem Streit ruhig geblieben bin','ich eine Aufgabe zu Hause regelmäßig erledige','ich mit anderen ein Fest vorbereitet habe','ich meine kleine Schwester betreue','ich ein schwieriges Spiel geduldig erklärt habe','ich bei einem Mannschaftsspiel gut mitarbeite','ich für meine Familie gekocht habe','ich im Unterricht eine Aufgabe übernommen habe','ich einem Mitschüler etwas ausgeliehen habe','ich einem Nachbarn geholfen habe','ich trotz Schwierigkeiten weitergeübt habe','ich ein Plakat für ein Schulprojekt gestaltet habe','ich ein Tier zuverlässig versorgt habe','ich einer Person aufmerksam zugehört habe','ich bei einem Projekt sorgfältig gearbeitet habe'],prompt:'Nenne eine ANDERE echte Situation als bei der ersten Stärke.'}
];
const names=['Mein Schreibweg','Mein Praktikum','Warum dieser Beruf?','Warum dieser Betrieb?','Meine Stärken','Meine Bewerbung','Für Pages herunterladen'];
const intros=['Hiermit bewerbe ich mich um einen Platz für mein Schülerpraktikum.','Gerne möchte ich mein Schülerpraktikum in Ihrem Betrieb absolvieren.','Mit diesem Schreiben bewerbe ich mich um ein Schülerpraktikum in Ihrem Betrieb.'];
const closings=['Über eine Rückmeldung würde ich mich sehr freuen.','Ich freue mich über die Möglichkeit, mein Praktikum bei Ihnen zu machen.','Über eine Einladung zu einem persönlichen Gespräch würde ich mich freuen.'];
const state={mode:'',job:'',company:'',period:'',reason2:'',introChoice:0,closingChoice:0,answers:Array(6).fill(''),variants:Array(6).fill(0),notes:Array(6).fill(''),intro:'',middle:'',end:'',final:'',school:'',experience:'',hobbies:'',quiz1:'',quiz2:''};
let step=0;const $=id=>document.getElementById(id);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function clean(s){return String(s||'').trim().replace(/[.\s]+$/,'')}
function sentence(i){const a=clean(state.answers[i]);if(i===0){const b=clean(state.reason2);return a&&b?chapters[0].options[state.variants[0]]+' '+a+' und '+b+'.':''}return a?chapters[i].options[state.variants[i]]+' '+a+'.':''}
function ptext(i){return state.mode==='b'?sentence(i):state.notes[i].trim()}
function para(i){return state.mode==='b'?sentence(i):''}
function generated(){const job=state.job.trim();const intro=[intros[state.introChoice],para(0),para(1)].filter(Boolean).join('\n\n');const strengths=[para(2),para(3),para(4),para(5)].filter(Boolean).join(' ');return `Bewerbung um ein Schülerpraktikum${job?' im Bereich '+job:''}\n\nSehr geehrte Damen und Herren,\n\n${intro||'[Hier schreibst du, warum dich der Beruf und der Betrieb interessieren.]'}\n\n${strengths||'[Hier schreibst du über zwei Stärken und passende Beispiele.]'}\n\n${closings[state.closingChoice]}\n\nMit freundlichen Grüßen\n\n[Vorname Nachname]`}
function letter(){return `[Vorname Nachname]\n[Straße und Hausnummer]\n[PLZ und Ort]\n\n${state.company||'[Name des Betriebs]'}\n[Anschrift des Betriebs]\n\n[Ort], [Datum]\n\n${state.final||generated()}`}
function cv(){return `LEBENSLAUF\n\nName: [Vorname Nachname]\nAdresse: [Straße, Hausnummer, PLZ, Ort]\nGeburtsdatum: [optional ergänzen]\n\nSCHULE\n${state.school||'[Schule und Klasse ergänzen]'}\n\nERFAHRUNGEN UND KENNTNISSE\n${state.experience||'[optional ergänzen]'}\n\nINTERESSEN UND HOBBYS\n${state.hobbies||'[optional ergänzen]'}\n\n[Ort], [Datum]`}
function reflection(){return `MEINE GEDANKEN ZUR PRAKTIKUMSBEWERBUNG\n\nBeruf: ${state.job}\nBetrieb: ${state.company}\n\nWARUM DIESER BERUF?\n${ptext(0)}\n\nWARUM DIESER BETRIEB?\n${ptext(1)}\n\nMEINE ERSTE STÄRKE\n${ptext(2)}\nBeispiel: ${ptext(3)}\n\nMEINE ZWEITE STÄRKE\n${ptext(4)}\nBeispiel: ${ptext(5)}\n\nMein Schreibweg: ${state.mode==='a'?'Selbst schreiben':'Lückentext'}`}
function textfield(key,label,placeholder){return `<div class="field"><label for="${key}">${label}</label><input type="text" id="${key}" data-key="${key}" value="${esc(state[key])}" placeholder="${esc(placeholder)}"></div>`}
function textarea(key,label,placeholder,rows=4){return `<div class="field"><label for="${key}">${label}</label><textarea id="${key}" rows="${rows}" data-key="${key}" placeholder="${esc(placeholder)}">${esc(state[key])}</textarea></div>`}
function help(i){return `<details><summary>💡 Ich brauche Ideen und Beispiele</summary><div class="help"><p><strong>Nur Denkanstöße – verwende etwas, das wirklich zu dir passt.</strong></p><ul>${chapters[i].ideas.map(s=>`<li>${esc(s)}</li>`).join('')}</ul></div></details>`}
function chapter(i){const ch=chapters[i];let h=`<div class="pill">${esc(ch.title)}</div><p>${esc(ch.prompt)}</p>`;if(state.mode==='b'){h+=`<div class="field"><div class="label">Wähle einen Satzanfang:</div>${ch.options.map((s,j)=>`<label class="choice"><input type="radio" name="variant${i}" data-variant="${i}" value="${j}" ${state.variants[i]===j?'checked':''}>${esc(s)} …</label>`).join('')}</div><div class="start" id="start${i}">${esc(ch.options[state.variants[i]])} …</div>${i===0?`<div class="pair"><div><label for="reason1"><strong>Erster Grund:</strong></label><textarea class="continuation" autocapitalize="off" spellcheck="true" id="reason1" data-answer="0" rows="3" placeholder="z. B. gerne mit Kindern arbeite">${esc(state.answers[0])}</textarea></div><div><label for="reason2"><strong>und … Zweiter Grund:</strong></label><textarea class="continuation" autocapitalize="off" spellcheck="true" id="reason2" data-reason2 rows="3" placeholder="z. B. ihnen etwas beibringen möchte">${esc(state.reason2)}</textarea></div></div>`:`<textarea class="continuation" autocapitalize="off" data-answer="${i}" rows="3" placeholder="Schreibe den Satz mit einem kleinen Buchstaben weiter …">${esc(state.answers[i])}</textarea>`}${help(i)}<p class="smallprint">Achte darauf, dass dein Satz grammatisch zum Anfang passt. Schreibe nur eigene, wahre Erfahrungen.</p><div class="preview" id="preview${i}">${esc(sentence(i)||ch.options[state.variants[i]]+' …')}</div>`}else{h+=`<div class="field"><label for="note${i}">Deine Notizen – Stichpunkte reichen:</label><textarea id="note${i}" data-note="${i}" rows="4" placeholder="Was möchtest du später in deiner Bewerbung sagen?">${esc(state.notes[i])}</textarea></div>${help(i)}<details><summary>✍️ Ich brauche einen Satzanfang</summary><ul>${ch.options.map(s=>`<li>${esc(s)} …</li>`).join('')}</ul></details>`}return h}
function render(){ $('count').textContent=`Schritt ${step+1} von ${names.length}`;$('bar').style.width=((step+1)/names.length*100)+'%';$('steps').innerHTML=names.map((n,i)=>`<button data-step="${i}" class="${i===step?'active':''}" title="${esc(n)}">${i+1}</button>`).join('');let h=`<h2>${names[step]}</h2>`;
if(step===0)h+=`<p>Du entscheidest, wie du deine Bewerbung schreibst. Beide Wege helfen dir, deine eigenen Erfahrungen zu beschreiben.</p><label class="choice"><input type="radio" name="mode" value="a" ${state.mode==='a'?'checked':''}><strong>Weg A: Ich schreibe selbst.</strong><br><span class="sub">Ich sammle Notizen und formuliere später selbst. Hilfen kann ich einblenden.</span></label><label class="choice"><input type="radio" name="mode" value="b" ${state.mode==='b'?'checked':''}><strong>Weg B: Ich ergänze Satzanfänge.</strong><br><span class="sub">Ich wähle einen Satzanfang und schreibe ihn direkt weiter. So entsteht meine Bewerbung Schritt für Schritt.</span></label><p class="sub">Du kannst den Weg später wechseln. Deine Eingaben für beide Wege bleiben erhalten, solange diese Seite geöffnet ist.</p>`;
if(step===1)h+=`<p>Du brauchst deinen Beruf und deinen Betrieb bereits. Hier findet <strong>kein Berufswahltest</strong> statt.</p>${textfield('job','Welchen Beruf möchtest du kennenlernen?','z. B. Erzieherin / Kfz-Mechatroniker')}${textfield('company','Bei welchem Betrieb möchtest du dich bewerben?','z. B. Kindertagesstätte Sonnenschein')}${textfield('period','Wann findet dein Praktikum statt? (freiwillig)','z. B. 12.–23. April')}<div class="note">Namen, Adressen und andere persönliche Daten ergänzt du erst später in Pages.</div>`;
if(step===2)h+=chapter(0);
if(step===3)h+=chapter(1);
if(step===4)h+=`<p>Wähle zwei Stärken und überlege zu jeder eine <strong>echte Situation</strong>, in der du sie gezeigt hast.</p><h3>Stärke 1</h3>${chapter(2)}<h3>Mein Beispiel zu Stärke 1</h3>${chapter(3)}<h3>Stärke 2</h3>${chapter(4)}<h3>Mein Beispiel zu Stärke 2</h3>${chapter(5)}`;
if(step===5){h+=`<h3>Wähle einen Anfangssatz</h3>${intros.map((x,i)=>`<label class="choice"><input type="radio" name="introChoice" value="${i}" ${state.introChoice===i?'checked':''}>${esc(x)}</label>`).join('')}<h3>Wähle einen Schlusssatz</h3>${closings.map((x,i)=>`<label class="choice"><input type="radio" name="closingChoice" value="${i}" ${state.closingChoice===i?'checked':''}>${esc(x)}</label>`).join('')}`;if(state.mode==='a')h+=`<p>Nutze deine Notizen aus den vorherigen Schritten. Schreibe jetzt dein Anschreiben in eigenen Worten. Die Satzanfänge sind nur freiwillige Hilfen.</p><details><summary>📝 Meine gesammelten Notizen ansehen</summary><div class="help">${chapters.map((c,i)=>`<p><strong>${esc(c.title)}:</strong> ${esc(state.notes[i]||'–')}</p>`).join('')}</div></details>${textarea('intro','Einleitung: Warum dieser Beruf und dieser Betrieb?','Ich möchte …',6)}${textarea('middle','Hauptteil: Zwei Stärken mit echten Beispielen','Eine meiner Stärken …',7)}${textarea('end','Schluss: Bitte freundlich um eine Rückmeldung','Über eine Rückmeldung …',3)}<button id="make-own" class="alt">Meine Texte in die Bewerbung übernehmen</button>`;else h+=`<p>Hier siehst du die Sätze aus deinen Lücken. Prüfe, ob alles zusammenpasst. Du kannst den ganzen Text gleich darunter verändern.</p><button id="refresh" class="alt">Meine ausgefüllten Sätze in die Bewerbung übernehmen</button><p class="smallprint">Achtung: Dadurch wird der Text im Feld darunter ersetzt.</p>`;
h+=`<div class="field"><label for="finalText">Meine vollständige Bewerbung – hier kann ich alles korrigieren:</label><textarea id="finalText" rows="19" placeholder="Deine Bewerbung …">${esc(state.final||generated())}</textarea></div><div class="note"><strong>Prüfe vor dem Download:</strong> Sind alle Sätze vollständig? Passen die Endungen? Stehen nur wahre Aussagen darin? Ist die Anrede höflich? Lies den Text laut vor oder bitte um eine Rückmeldung.</div>`;}
if(step===6)h+=`<p>Geschafft! Lade deine Bewerbung als <strong>Word-Datei (.docx)</strong> herunter. Du kannst sie auf dem iPad in <strong>Apple Pages</strong> öffnen, bearbeiten und als Pages-Dokument speichern.</p><div class="field"><label>Vorschau deiner Bewerbung</label><div class="preview">${esc(letter())}</div></div><div class="row"><button id="dl-letter">📄 Bewerbung für Pages (.docx)</button><button id="dl-cv" class="alt">📄 Lebenslauf für Pages (.docx)</button></div><h3>Angaben für den Lebenslauf</h3>${textfield('school','Schule und Klasse','z. B. Gesamtschule, Klasse 8')}${textarea('experience','Erfahrungen oder Kenntnisse (freiwillig)','z. B. Schulprojekt, Erste Hilfe, Sprachen',3)}${textarea('hobbies','Hobbys und Interessen (freiwillig)','z. B. Fußball, Zeichnen, Kochen',3)}<button id="dl-reflect" class="alt">📝 Meine Gedanken als Word-Datei</button><div class="note">Ergänze erst in Pages: deinen Namen, Anschriften, Datum, gegebenenfalls den Praktikumszeitraum. Speichere die Datei anschließend in Pages. Kontrolliere auch die Formatierung.</div>`;
$('stage').innerHTML=h;$('back').disabled=step===0;$('next').textContent=step===6?'Zurück zum Anfang':'Weiter →';bind();}
function bind(){document.querySelectorAll('[data-key]').forEach(e=>e.addEventListener('input',()=>state[e.dataset.key]=e.value));document.querySelectorAll('[data-note]').forEach(e=>e.addEventListener('input',()=>state.notes[+e.dataset.note]=e.value));document.querySelectorAll('[data-answer]').forEach(e=>e.addEventListener('input',()=>{const i=+e.dataset.answer;state.answers[i]=e.value;const pv=$('preview'+i);if(pv)pv.textContent=sentence(i)||chapters[i].options[state.variants[i]]+' …'}));document.querySelectorAll('[data-reason2]').forEach(e=>e.addEventListener('input',()=>{state.reason2=e.value;const pv=$('preview0');if(pv)pv.textContent=sentence(0)||chapters[0].options[state.variants[0]]+' …'}));['introChoice','closingChoice'].forEach(k=>document.querySelectorAll(`[name=${k}]`).forEach(e=>e.addEventListener('change',()=>{state[k]=+e.value;if(state.mode==='b'){state.final='';render();}})));document.querySelectorAll('[data-variant]').forEach(e=>e.addEventListener('change',()=>{const i=+e.dataset.variant;state.variants[i]=+e.value;$('start'+i).textContent=chapters[i].options[state.variants[i]]+' …';$('preview'+i).textContent=sentence(i)||chapters[i].options[state.variants[i]]+' …'}));document.querySelectorAll('[name=mode]').forEach(e=>e.addEventListener('change',()=>{state.mode=e.value;render()}));['quiz1','quiz2'].forEach(k=>document.querySelectorAll(`[name=${k}]`).forEach(e=>e.addEventListener('change',()=>{state[k]=e.value;render()})));document.querySelectorAll('[data-step]').forEach(e=>e.addEventListener('click',()=>{step=+e.dataset.step;render()}));if($('finalText'))$('finalText').addEventListener('input',e=>state.final=e.target.value);if($('make-own'))$('make-own').onclick=()=>{const composed=`Bewerbung um ein Schülerpraktikum${state.job?' im Bereich '+state.job:''}\n\nSehr geehrte Damen und Herren,\n\n${intros[state.introChoice]}\n\n${state.intro}\n\n${state.middle}\n\n${state.end||closings[state.closingChoice]}\n\nMit freundlichen Grüßen\n\n[Vorname Nachname]`;if(state.final&&!confirm('Deinen bisherigen Bewerbungstext durch die selbst geschriebenen Absätze ersetzen?'))return;state.final=composed;render()};if($('refresh'))$('refresh').onclick=()=>{if(state.final&&!confirm('Den bisher bearbeiteten Text durch die ausgefüllten Satzanfänge ersetzen?'))return;state.final=generated();render()};if($('dl-letter'))$('dl-letter').onclick=()=>downloadDocx('Meine_Praktikumsbewerbung_fuer_Pages.docx',letter());if($('dl-cv'))$('dl-cv').onclick=()=>downloadDocx('Mein_Lebenslauf_fuer_Pages.docx',cv());if($('dl-reflect'))$('dl-reflect').onclick=()=>downloadDocx('Meine_Gedanken.docx',reflection());}
